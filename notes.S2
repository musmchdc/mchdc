function doGet(e) {
  var apogee = e.parameter.apogee;
  var sheet = SpreadsheetApp.openById("1dwBUzsKWLuLFpZ8KN7FIxSDZ5WWTSCl3MUo8HRMOg0w").getSheetByName("Feuille 1");
  var data = sheet.getDataRange().getValues();
  var headers = data[0];
  var result = "Introuvable";
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][1]).trim() == String(apogee).trim()) {
      result = "Etudiant: " + data[i][2] + " " + data[i][3] + "\n";
      for (var j = 5; j < 13; j++) {
        if (headers[j] != "" && data[i][j] !== "") {
          var note = data[i][j];
          if (note instanceof Date) {
            note = note.getDate() + (note.getMonth() > 0 ? 0.5 : 0);
          }
          result += headers[j] + ": " + note + "/20\n";
        }
      }
      result += "Moyenne generale: " + data[i][13] + "/20\n";
      break;
    }
  }
  return ContentService.createTextOutput(result);
}
